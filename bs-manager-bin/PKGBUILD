# Maintainer: Sophie <goldsnakeking@gmail.com>

# BSManager, repacked from upstream's official .rpm WITHOUT being stripped.
#
# ---------------------------------------------------------------------------
# WHY THIS EXISTS: IN THE AUR's bs-manager-bin, "Download" DOES NOTHING.
#
# Clicking Download for a Beat Saber version there (1.6.0-1) gives no Steam
# login, no QR code and no error; at most the window blinks. Upstream issues
# #1137 and #1120 (both 1.6.0, both open, no maintainer reply) and #988.
#
# BSManager runs /opt/BSManager/resources/assets/scripts/DepotDownloader for
# the download, and that file is a .NET single-file program: an 11.8 MB ELF
# host (the launcher with the native runtime linked into it) with 67.6 MB of
# bundle (the framework's managed assemblies and the application itself)
# appended after the ELF image. makepkg's strip pass rewrites every ELF it
# finds and keeps only what the section table describes, so the bundle is cut
# off. The host then exits at once with code 159 and, on stderr,
#     Failure processing application bundle; possible file corruption.
# BSManager reads only the helper's stdout and treats its exit as the end of
# a normal run, so that message never reaches the log. What the failure
# leaves there is two lines with one timestamp:
#     [info]  DepotDownloader process end with code 159
#     [error] initVersionMetadata error Error: ENOENT: no such file or
#             directory, open '.../BSInstances/<v>/metadata.config'
# The second is the same fault, not another one: the helper never got as far
# as creating the version's directory. (159 is the low byte of .NET's
# BundleExtractionFailure, 0x8000809f. It is not SIGSYS, whatever 128+31
# suggests, and has nothing to do with seccomp.)
#
# Measured here on 13/11/2026 with this machine's makepkg.conf:
#   as shipped       79413529 bytes, prints "DepotDownloader v3.4.0" + usage
#   after `strip --strip-unneeded` (what makepkg runs on a PIE)
#                    11831712 bytes, exits 159 with the message above
#   the AUR PKGBUILD built unchanged gives exactly the second file.
# Run from this package with BSManager's own arguments (-app 620980 -depot
# 620981 -dir <v> -manifest <id> -qr) it connects to Steam and prints the
# "[Info]|[QRCode]|https://s.team/q/..." line the window draws its QR code
# from.
#
# Hence options=('!strip'), for the whole package rather than that one file.
# It is the only file in 1.6.0 with data after its ELF image, but stripping a
# prebuilt Electron gains next to nothing, and the AUR's bs-manager-git has
# carried '!strip' since 16/10/2024 for this same helper ("Stripping corrupts
# the bundled version of DepotDownloader"). Keep it when upstream releases
# the Rust helper (bs-downloader) that replaces DepotDownloader on its main
# branch, until that one has been measured the same way.
#
# DO NOT "FIX" THIS BY DROPPING IN SteamRE's DepotDownloader, as the advice
# under #988 says. That advice dates from 1.5.4-1.5.6; upstream replaced the
# helper for 1.6.0 (PR #1082, "the broken Linux DepotDownloader executable").
# The bundled file is BSManager's fork: it prints the "[Info]|[Tag]|data"
# lines the window parses. The stock program downloads, but its QR code goes
# to a terminal nobody sees and there is no progress bar.
#
# check() runs the helper as shipped, so a release whose helper does not
# start on this machine fails the build instead of the Download button.
# check() cannot see what makepkg does AFTER package(), which is where strip
# runs, so after touching options= confirm the built package by hand, from
# this directory:
#   bsdtar -xOf "$(makepkg --packagelist)" \
#       opt/BSManager/resources/assets/scripts/DepotDownloader | wc -c
# must print the first size above, not ~11.8 MB. (--packagelist names the
# file for the current pkgver-pkgrel. A *.pkg.tar.zst glob would not do:
# makepkg leaves earlier builds here and bsdtar would read the oldest.)
# ---------------------------------------------------------------------------
#
# WHAT ELSE DIFFERS FROM THE AUR PACKAGE
#
# - It depends on openssl-3. The helper's .NET 9 runtime loads libssl itself
#   and tries .so.3, 1.1, 1.0.2, 1.0.0 and 10, never .so.4, and aborts with
#   "No usable version of libssl was found" when none loads. `openssl` is 4.x
#   now, so nothing else guarantees a libssl.so.3: on 13/11/2026 openssl-3
#   was on this machine only as a dependency of nodejs-lts-jod.
# - /usr/bin/bs-manager exists. Upstream creates that link in the .rpm's
#   post-install script, which a repack never runs.
# - depends is what the binaries link against, load and run, not the .rpm's
#   Requires (which is what the AUR package lists).
#
# AND WHAT DELIBERATELY DOES NOT
#
# - resources/package-type stays, saying "rpm". electron-updater reads it to
#   choose its updater, and that one would install a downloaded .rpm as root
#   with zypper, dnf, yum or rpm, behind pacman's back. In 1.6.0 nothing on
#   Linux can start that: the main window opens directly instead of the
#   updater window, and the title bar does not draw its "Update and Restart"
#   button there. All the file does is let the title bar check GitHub at
#   start and show an OUTDATED badge with a link to the release notes, which
#   for a package bumped by hand is the one cue that a bump is due. If a later
#   release can install on Linux, delete the file in package(): without it
#   electron-updater reports itself inactive unless $APPIMAGE is set, and
#   BSManager reads that as "no update".
# - chrome-sandbox stays 0755. Upstream's .rpm script makes it setuid root
#   only where unprivileged user namespaces do not work; here they do
#   (kernel.unprivileged_userns_clone=1, the default of every Arch kernel but
#   linux-hardened), and Chromium then uses the namespace sandbox. On a
#   kernel without them the app refuses to start and says so: chmod 4755
#   that file there.
#
# The .rpm and the .deb hold the same /opt/BSManager file for file, apart from
# that package-type marker. The .rpm is used because it is the one upstream
# publishes a hash for (latest-linux.yml, sha512), and it is the smaller.
#
# TO BUMP: update pkgver and the sha256sum, and compare the new file with the
# sha512 in latest-linux.yml from the same release:
#   openssl dgst -sha512 -binary bs-manager-bin-<ver>.rpm | base64 -w0
# Then let check() run, do the hand check above, and re-read this header
# against the new release: whether it can now update itself on Linux (see
# package-type), and, once it ships bs-downloader, what _helper is, what it
# prints and whether it still wants a libssl.

pkgname=bs-manager-bin
pkgver=1.6.0
pkgrel=1
pkgdesc="Beat Saber version, map and mod manager (prebuilt, with a working version download)"
arch=('x86_64')
url="https://github.com/Zagrios/bs-manager"
# BSManager itself: upstream's LICENSE is the GPLv3 text and its root
# package.json says "GPL-3.0-only". (The "MIT" in the .rpm's own tag is not
# that licence: electron-builder copies it from upstream's
# release/app/package.json, which says "MIT".) The bundled DepotDownloader
# fork is GPL-2.0-only; Electron and Chromium ship their notices in
# /opt/BSManager, linked from the licence directory below.
license=('GPL-3.0-only')
depends=(
	# linked
	'alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'glib2' 'glibc' 'gtk3'
	'libcups' 'libgcc' 'libstdc++' 'libx11' 'libxcb' 'libxcomposite'
	'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'mesa'
	'nspr' 'nss' 'pango' 'systemd-libs'
	# loaded at run time: notifications, the keyring, and TLS for
	# DepotDownloader (see the header; it is built with invariant
	# globalization, so it needs no ICU)
	'libnotify' 'libsecret' 'openssl-3'
	# run by the app: links, its shell commands, finding running processes
	'xdg-utils' 'bash' 'procps-ng' 'grep'
	'hicolor-icon-theme'
)
optdepends=('steam: to launch Beat Saber (downloading a version does not need it)')
provides=('bs-manager')
conflicts=('bs-manager' 'bs-manager-git')
options=('!strip')
source=("$pkgname-$pkgver.rpm::$url/releases/download/v$pkgver/bs-manager-$pkgver.$CARCH.rpm")
noextract=("$pkgname-$pkgver.rpm")
sha256sums=('f701450bca18084904cdee2aa4abc9d8f58787375272b8eab6d83040ac30d0b2')

_helper=opt/BSManager/resources/assets/scripts/DepotDownloader

check() {
	# The helper exactly as upstream shipped it, run without arguments: it
	# prints its version and usage and exits 0. No network, and a HOME of its
	# own in case a later version writes there.
	rm -rf "$srcdir/check"
	install -dm755 "$srcdir/check/home"
	bsdtar -xf "$srcdir/$pkgname-$pkgver.rpm" -C "$srcdir/check" "./$_helper"
	HOME="$srcdir/check/home" "$srcdir/check/$_helper" > "$srcdir/check/out.txt"
	grep -q '^DepotDownloader v' "$srcdir/check/out.txt"
}

package() {
	# An .rpm is a header followed by a cpio archive, which bsdtar reads as
	# one file. Unpacked straight into $pkgdir: 424 MB do not need copying
	# twice.
	bsdtar -xf "$srcdir/$pkgname-$pkgver.rpm" -C "$pkgdir"

	# rpm's build-id links into /opt, of no use to pacman. rmdir, not rm -r:
	# if a later release puts anything else in /usr/lib, this fails loudly.
	rm -r "$pkgdir/usr/lib/.build-id"
	rmdir "$pkgdir/usr/lib"

	install -dm755 "$pkgdir/usr/bin"
	ln -s /opt/BSManager/bs-manager "$pkgdir/usr/bin/bs-manager"

	install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
	ln -s /opt/BSManager/LICENSE.electron.txt \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE.electron.txt"
	ln -s /opt/BSManager/LICENSES.chromium.html \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSES.chromium.html"
}
