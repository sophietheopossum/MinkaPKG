# makepkg build artefacts — one src/ and pkg/ per package directory
*/src/
*/pkg/

# Built packages and downloaded sources. Local patches and .desktop files are
# deliberately NOT ignored: those are inputs and belong in the repo.
*.pkg.tar.zst
*.pkg.tar.zst.sig
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
*.deb
*.rpm
*.AppImage
# Loose (non-archive) source= downloads, e.g. renbrowser's pinned micron wasm
# and its wasm_exec shim. Both are fetched by makepkg and verified by
# sha256sums; a 4 MB wasm blob does not belong in git.
*.wasm
wasm_exec-*.js
sheetbro-bin/sheetbro-bin-*-LICENSE

# Floorp's saved PGO profile (named by runtime commit, reused so a rebuild of the
# same runtime skips the profiling build) and makepkg's clone of its git source.
floorp/floorp-runtime-*-merged.profdata
floorp/floorp-runtime-*-jarlog
floorp/floorp-projects.floorp-core/

firestorm-novlc/firestorm/

firestorm-novlc/fs-build-variables/

# makepkg's clone of the bcachefs-tools git source (not the whole directory:
# its PKGBUILD, patches and upstream file are tracked).
bcachefs-dkms/bcachefs-tools/

# makepkg's clone of the libcaca git source (the patches are tracked).
lib32-libcaca/libcaca/
