# makepkg build artefacts — one src/ and pkg/ per package directory
*/src/
*/pkg/

# Built packages and downloaded sources. Local patches and .desktop files are
# deliberately NOT ignored: those are inputs and belong in the repo.
*.pkg.tar.zst
*.pkg.tar.zst.sig
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
# Loose (non-archive) source= downloads, e.g. renbrowser's pinned micron wasm
# and its wasm_exec shim. Both are fetched by makepkg and verified by
# sha256sums; a 4 MB wasm blob does not belong in git.
*.wasm
wasm_exec-*.js
