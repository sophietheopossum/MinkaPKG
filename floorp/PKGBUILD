## options
: ${_build_pgo:=true}      # profile-guided optimization; ~20% better benchmarks, 3x build time
: ${_build_pgo_reuse:=try} # reuse previously generated profile
: ${_build_pgo_xvfb:=true} # use xfvb for profiling, otherwise xwayland-run

: ${_build_lto:=false}        # link-time optimization; may cause spurious errors
: ${_build_lto_mode:=thin}   # thin|full. FULL does not fit 15 GiB alongside a desktop: the
                             # 7/9/2026 attempt peaked 9.3 GiB resident + 9.6 GiB swap and
                             # took the session down with it. Thin is still LTO.
: ${_build_system_libs:=true} # use system libraries, reduces build time

: ${_build_limit_cores:=auto} # number of cores for parallelism; or auto, limited by RAM

: ${_install_path:=usr/lib}
: ${_wmclass:=floorp}

: ${_runtime_commit:=c74fe1a545d275cdd710ab44701c1ee0dd6b0eae} # daily-1142

_pkgname="floorp"
