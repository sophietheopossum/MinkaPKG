_pkgsrc="Floorp-$pkgver"
_pkgsrc_runtime="Floorp-Runtime-$_runtime_commit"
_pkgext="tar.gz"
source=(
  "$_pkgname-components-$pkgver.$_pkgext"::"https://github.com/Floorp-Projects/Floorp/archive/refs/tags/v$pkgver.$_pkgext"
  "$_pkgname-runtime-${_runtime_commit::7}.$_pkgext"::"https://github.com/Floorp-Projects/Floorp-Runtime/archive/$_runtime_commit.$_pkgext"
  "floorp-projects.floorp-core"::"git+https://github.com/Floorp-Projects/Floorp-core.git"
  "$_pkgname.desktop"
  '0002-vendor-must-be-implied-not-confvars.patch'
  '0003-field-initializers-must-not-undo-init.patch'
)
sha256sums=(
  'f596fc1bda0c9118be83c76bcc981ffe4e9eb4f4447a4793ddcd558ec1e6b410'
  'SKIP'
  'SKIP'
  '8b38d000950cddd5fa0e1598540590af21f1aae1d30212fb11197c8526662604'
  # 0002 only drops MOZ_APP_VENDOR from the branding's configure.sh (a confvars
  # assignment configure rejects). It must NOT touch browser/moz.configure: Floorp's
  # own upstream/moz.configure.patch owns that file and brings the "Ablaze" vendor in
  # through .github/assets/config/moz.configure.
  '6319b6209509c2fb98f302fe187abeeab4783c198cb2941f2bcc7d851e84c973'
  # 0003 is for Floorp's own sources, in the copy prepare() makes under noraneko/.
  # Two features threw their saved settings away at every start: idle memory reclaim
  # did not run until its setting was changed in the running browser, and tab-sleep
  # exclusions stopped applying at the first navigation. The file says what it changes
  # and when to drop it. If a new Floorp no longer has the lines it removes, `patch`
  # fails right here in prepare(), before anything is compiled. prepare() is the only
  # place a source[] patch is applied: the first build after adding one must not be
  # `makepkg -e`, which skips prepare() and would package the tree without it.
  'fa3ee14771eddfa1d3ccdae4085efe88765e87ddf63a4965b4d8866c5cbdf8a6'
)

_deno() {
  export DENO_DIR="$srcdir/.deno"
  pushd "$srcdir/$_pkgsrc_runtime/noraneko" > /dev/null || return
  deno "$@"
  popd > /dev/null || return
}

# Apply one of Floorp's own patches, or fail the build. The `git apply ... || true`
# this replaces is how a month of packages shipped with none of them applied. A patch
# that is already in the tree is accepted, so `makepkg -e` can re-run build().
# Call it as `_floorp_patch ... || exit 1`: that stops build() whether or not errexit
# is in force where it runs.
_floorp_patch() {
  local _patch="$1"
  shift
  if git apply --check "$@" "$_patch" 2> /dev/null; then
    git apply "$@" "$_patch"
  elif git apply --check --reverse "$@" "$_patch" 2> /dev/null; then
    echo "Already applied: $_patch"
  else
    echo "==> ERROR: Floorp patch does not apply: $_patch" >&2
    git apply --check "$@" "$_patch" || true # say why
    return 1
  fi
}

# The one upstream patch of Floorp's that build() leaves out. It makes
# CheckCompatibility() call the profile incompatible unless <profile>/buildid2 exists
# and equals the application's copy, and nothing in Floorp ever writes the profile's
# copy. So EVERY launch threw away the startup cache and the quota manager's origin
# cache: about a third of a second per start (measured 11/10/2026), and some 20 MB of
# cache files written again each time. The check is there for Floorp's own updater,
# which can ship a build that differs in buildid2 alone. This package has no updater,
# and every build() gets a new build ID (MOZ_BUILD_DATE, makepkg's start time), which
# Gecko's own LastVersion check answers with one purge, as it should.
# What no longer heals itself: files under /usr/lib/floorp changed WITHOUT a build()
# (makepkg -R after editing dist/bin, edits in place), or two builds under one
# exported SOURCE_DATE_EPOCH. Then start once with `floorp --purgecaches`.
# The sha256 is of the lines the patch adds; prepare() compares it.
_floorp_dropped_patch='toolkit-xre-nsAppRunner.cpp.patch'
_floorp_dropped_sha256='4cf22f8a75fac135618c6126cdfdbb59082db7e16841760b5c84d67768362ebc'

prepare() (
  mkdir -p mozbuild

  # prepare directories
  # rsync of the directory, not `cp -r "$_pkgsrc"/*`: the glob skips dotfiles, and
  # .npmrc is one of them (`@jsr:registry=`, which `deno install` needs to resolve
  # bridge/loader-modules' @jsr dependency on a fresh tree). The placement was never
  # the problem; see GIT_CEILING_DIRECTORIES in build().
  rsync -aL --mkpath "$_pkgsrc/" "$_pkgsrc_runtime/noraneko/"
  rsync -aL --mkpath "$_pkgsrc_runtime/.github/assets/branding/" "$_pkgsrc_runtime/browser/branding/"

  # A second makepkg run extracts over the tree the first one patched: every file
  # Floorp's patches MODIFIED is pristine again, but a file one of them CREATED is
  # still there, and `git apply` then refuses that patch in both directions
  # ("already exists in working directory"). Remove such leftovers, so the tree is
  # the tarball's again. upstream/macos-app-shim-pwa-input-and-compositor.patch
  # (new in the 12.20.1 runtime) is the first patch that creates a file.
  local _p _created
  for _p in "$_pkgsrc_runtime"/.github/patches/{upstream,packaging}/*.patch; do
    while IFS= read -r _created; do
      case "$_created" in
        *..*) continue ;;
      esac
      rm -f -- "$_pkgsrc_runtime/$_created"
    done < <(awk '/^--- \/dev\/null$/ { getline; if (sub(/^\+\+\+ b\//, "")) print }' "$_p")
  done

  # build() leaves $_floorp_dropped_patch out, which was decided for the patch as
  # runtime c74fe1a has it. Stop here, before hours of compiling, if a new runtime
  # renamed it or changed what it adds (line numbers and context may move freely).
  local _dropped="$_pkgsrc_runtime/.github/patches/upstream/$_floorp_dropped_patch"
  if [[ ! -f "$_dropped" ]] \
    || [[ "$(grep '^+' "$_dropped" | grep -v '^+++ ' | sha256sum)" != "$_floorp_dropped_sha256  -" ]]; then
    echo "==> ERROR: $_floorp_dropped_patch is gone or has changed; see _floorp_dropped_patch in the PKGBUILD" >&2
    exit 1
  fi

  # prepare api keys
  cp floorp-projects.floorp-core/apis/api-*-key ./

  # configure
  cat > mozconfig << END
ac_add_options --enable-application=browser
ac_add_options --disable-artifact-builds
mk_add_options MOZ_OBJDIR="$srcdir/$_pkgsrc_runtime/obj-artifact-build-output"

ac_add_options --prefix=/usr
ac_add_options --enable-release
ac_add_options --enable-hardening
ac_add_options --enable-rust-simd
ac_add_options --enable-linker=lld
ac_add_options --disable-elf-hack
ac_add_options --disable-bootstrap
ac_add_options --with-wasi-sysroot=/usr/share/wasi-sysroot

# Compiler cache. mozbuild distinguishes ccache / sccache / buildcache and adapts
# (see build/moz.configure/toolchain.configure); buildcache identifies itself via
# `--version`, which is how mozbuild picks the buildcache path. Configured in
# ~/.buildcache/config.json for direct mode + ZSTD. This matters more than it looks:
# makepkg re-extracts \$srcdir on every run, so without a cache each retry of this
# build starts from nothing.
ac_add_options --with-ccache=buildcache

# Branding
ac_add_options --with-app-basename=${_pkgname^}
ac_add_options --with-app-name=$_pkgname
ac_add_options --with-branding=browser/branding/floorp-official
ac_add_options --enable-update-channel=nightly
ac_add_options --with-distribution-id=org.archlinux
ac_add_options --with-unsigned-addon-scopes=app,system
ac_add_options --allow-addon-sideload
export MOZ_APP_NAME=$_pkgname
export MOZ_APP_REMOTINGNAME=$_pkgname
MOZ_REQUIRE_SIGNING=

# Keys
ac_add_options --with-mozilla-api-keyfile="$srcdir/api-mozilla-key"
ac_add_options --with-google-location-service-api-keyfile="$srcdir/api-google-location-service-key"
ac_add_options --with-google-safebrowsing-api-keyfile="$srcdir/api-google-safe-browsing-key"

# Features
ac_add_options --enable-alsa
ac_add_options --enable-eme=widevine
ac_add_options --enable-jack
ac_add_options --enable-jxl
ac_add_options --enable-proxy-bypass-protection
ac_add_options --enable-pulseaudio
ac_add_options --enable-sandbox
ac_add_options --enable-unverified-updates
ac_add_options --enable-webrtc
ac_add_options --disable-crashreporter
ac_add_options --disable-default-browser-agent
ac_add_options --disable-parental-controls
ac_add_options --disable-tests
ac_add_options --disable-updater

# Disables Telemetry by Default
mk_add_options MOZ_DATA_REPORTING=0
mk_add_options MOZ_SERVICES_HEALTHREPORT=0
mk_add_options MOZ_TELEMETRY_REPORTING=0

# Debugging
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-debug-js-modules
ac_add_options --enable-strip
ac_add_options --enable-install-strip
export STRIP_FLAGS="--strip-debug --strip-unneeded"

# Optimization
ac_add_options --enable-optimize
ac_add_options OPT_LEVEL="2"
ac_add_options RUSTC_OPT_LEVEL="2"

# Other
export AR=llvm-ar
export CC=clang
export CXX=clang++
export NM=llvm-nm
export RANLIB=llvm-ranlib
END

  if [[ "${_build_system_libs::1}" == "t" ]]; then
    cat >> mozconfig << END
# ac_add_options --with-system-av1
# ac_add_options --with-system-icu
# ac_add_options --with-system-libevent
# ac_add_options --with-system-png
ac_add_options --with-system-ffi
ac_add_options --with-system-gbm
ac_add_options --with-system-jpeg
ac_add_options --with-system-libdrm
ac_add_options --with-system-libvpx
ac_add_options --with-system-nspr
ac_add_options --with-system-nss
ac_add_options --with-system-pipewire
ac_add_options --with-system-pixman
ac_add_options --with-system-webp
ac_add_options --with-system-zlib
END
  fi

  if [[ "${_build_lto::1}" == "t" ]]; then
    cat >> mozconfig << END
ac_add_options --enable-lto=cross,${_build_lto_mode}
END
  fi

  # build parallelism
  local _mem _threads _cores _jobs
  _mem=$(grep -Pom1 '^MemAvailable:\s*\K[0-9]+' /proc/meminfo)
  _cores=$(lscpu | grep -Pom1 'per socket:\s*\K[0-9]+')
  _threads=$(nproc)
  _jobs="auto"

  if [[ "${_build_limit_cores}" =~ ^[at] ]]; then
    # calculate core availability based on free RAM and CPU count
    _jobs=$((_mem / (1024 * 1024) < _cores ? _mem / (1024 * 1024) : _cores - 1))
    _jobs=$((_jobs < 1 ? 1 : _jobs))
  elif ((${_build_limit_cores:-0} > 0)); then
    # user-specified, capped by CPU count
    _jobs=$((_build_limit_cores > _threads ? _threads : _build_limit_cores))
    _jobs=$((_jobs < 1 ? 1 : _jobs))
  fi

  printf '\n:: Free RAM: %-5s Cores: %-5s Threads: %-5s Jobs: %-5s\n\n' "$((_mem / (1024 * 1024)))" "$_cores" "$_threads" "$_jobs"

  if [[ "$_jobs" =~ ^[0-9]+$ ]]; then
    # NOT ../mozconfig. prepare() runs with cwd=$srcdir, so "../" writes to
    # $startdir/mozconfig, which nothing ever reads; build() reads $srcdir/mozconfig.
    # Because of this, _build_limit_cores NEVER applied and every build ran at mach's
    # default parallelism instead — the cause of two OOM failures on 7/9/2026.
    cat >> mozconfig << END
mk_add_options MOZ_PARALLEL_BUILD=${_jobs}
END
  fi

  # apply patches
  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.zst}"
    if [[ $src == *.patch ]]; then
      printf '\nApplying patch: %s\n' "$src"
      patch -d "$_pkgsrc_runtime" -Np1 -F100 -f -i "${srcdir:?}/$src"
    fi
  done
)

build() (
  export RUSTUP_TOOLCHAIN=stable

  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$srcdir/xdg-runtime}"
  [ ! -d "$XDG_RUNTIME_DIR" ] && mkdir -pm700 "${XDG_RUNTIME_DIR:?}"

  export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=pip
  export MOZBUILD_STATE_PATH="$srcdir/mozbuild"
  export MOZ_BUILD_DATE="$(date -u${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH} +%Y%m%d%H%M%S)"
  export MOZ_NOSPAM=1

  # malloc_usable_size is used in various parts of the codebase
  CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

  # Breaks compilation since https://bugzilla.mozilla.org/show_bug.cgi?id=1896066
  CFLAGS="${CFLAGS/-fexceptions/}"
  CXXFLAGS="${CXXFLAGS/-fexceptions/}"

  # LTO/PGO needs more open files
  ulimit -n 4096

  # $srcdir sits inside this packaging repo's work tree (inside an AUR helper's clone
  # it would too). There `git apply` reads patch paths relative to the REPO root,
  # skips every one that falls outside the current directory ("Skipped patch") and
  # exits 0. So not one of Floorp's patches applied, including the line that adds
  # noraneko/ to the build: every package up to pkgrel 3 was Firefox with Floorp's
  # branding and none of its features (found 10/10/2026). Capping the repository
  # search at $srcdir makes git treat the extracted tree as what it is.
  export GIT_CEILING_DIRECTORIES="$srcdir"

  cd "$_pkgsrc_runtime"

  # Do 3-tier PGO
  if [[ "${_build_pgo::1}" == "t" ]] && [ "${_build_artifact_mode::1}" != "t" ]; then
    # Old profile loction
    local _pkgver_prof="${_runtime_commit::7}"
    local _old_profdata="$SRCDEST/floorp-runtime-$_pkgver_prof-merged.profdata"
    local _old_jarlog="$SRCDEST/floorp-runtime-$_pkgver_prof-jarlog"

    # Restore old profile
    if [[ "${_build_pgo_reuse::1}" == "t" ]]; then
      if [[ -s "$_old_profdata" ]]; then
        echo "Restoring old profile data."
        cp -f "$_old_profdata" merged.profdata
      fi

      if [[ -s "$_old_jarlog" ]]; then
        echo "Restoring old jar log."
        cp -f "$_old_jarlog" jarlog
      fi
    fi

    # Make new profile
    if [[ "${_build_pgo_reuse::1}" != "t" ]] || [[ ! -s merged.profdata ]]; then
      echo "Building instrumented browser..."
      cat > .mozconfig ../mozconfig - << END
ac_add_options --enable-profile-generate=cross
export MOZ_ENABLE_FULL_SYMBOLS=1

# prevent error during instrumented build
ac_add_options --enable-official-branding
END
      ./mach build --priority normal

      echo "Profiling instrumented browser..."
      ./mach package

      local _headless_env=(
        LLVM_PROFDATA=llvm-profdata
        JARLOG_FILE="$srcdir/$_pkgsrc_runtime/jarlog"
        LIBGL_ALWAYS_SOFTWARE=true
        dbus-run-session
      )

      if [[ "${_build_pgo_xvfb::1}" == "t" ]]; then
        local _headless_run=(
          xvfb-run
          -s "-screen 0 1920x1080x24 -nolisten local"
        )
      else
        local _headless_run=(
          wlheadless-run
          -c weston --width=1920 --height=1080
        )
      fi

      env "${_headless_env[@]}" "${_headless_run[@]}" -- ./mach python build/pgo/profileserver.py

      echo "Removing instrumented browser..."
      ./mach clobber objdir
    fi
  fi

  # Prepare to rebuild
  cat > .mozconfig ../mozconfig

  if [ "${_build_artifact_mode::1}" != "t" ]; then
    if [[ -s merged.profdata ]]; then
      stat -c "Profile data found (%s bytes)" merged.profdata
      cat >> .mozconfig - << END
ac_add_options --enable-profile-use=cross
ac_add_options --with-pgo-profile-path="$srcdir/$_pkgsrc_runtime/merged.profdata"
END

      # save profdata for reuse
      cp -f merged.profdata "$_old_profdata"
    else
      echo "Profile data not found."
    fi

    if [[ -s jarlog ]]; then
      stat -c "Jar log found (%s bytes)" jarlog
      cat >> .mozconfig - << END
ac_add_options --with-pgo-jarlog="$srcdir/$_pkgsrc_runtime/jarlog"
END

      # save jarlog for reuse
      cp -f jarlog "$_old_jarlog"
    else
      echo "Jar log not found."
    fi
  fi

  # Final build
  echo "Preparing floorp..."

  # floorp patches 1/3
  for i in .github/patches/upstream/*.patch; do
    if [[ "${i##*/}" == "$_floorp_dropped_patch" ]]; then
      if git apply --check --reverse --ignore-space-change --ignore-whitespace "$i" 2> /dev/null; then
        # makepkg -e on a tree an earlier build() patched: take it back out.
        git apply --reverse --ignore-space-change --ignore-whitespace "$i" || exit 1
        echo "Removed: $i"
      elif git apply --check --ignore-space-change --ignore-whitespace "$i" 2> /dev/null; then
        echo "Left out: $i"
      else
        echo "==> ERROR: $i is neither in the tree nor out of it" >&2
        exit 1
      fi
      # makepkg without -e has just extracted the tarball's file over the patched one,
      # with the tarball's date: older than the object an earlier build() compiled
      # from the patched file. make would keep that object, and the check with it.
      local _dropped_src
      _dropped_src=$(sed -n 's#^+++ b/##p' "$i")
      if [[ ! -f "$_dropped_src" ]]; then
        echo "==> ERROR: $i does not name one existing file" >&2
        exit 1
      fi
      touch -- "$_dropped_src" || exit 1
      continue
    fi
    _floorp_patch "$i" --ignore-space-change --ignore-whitespace || exit 1
  done

  # floorp pre-mach
  _deno install --allow-scripts
  _deno task feles-build misc writeVersion
  NODE_ENV=production _deno task feles-build build --phase before-mach

  # floorp patches 2/3
  for i in .github/patches/packaging/*.patch; do
    _floorp_patch "$i" --ignore-space-change --ignore-whitespace || exit 1
  done

  # The one line that makes the build traverse noraneko/ at all. Without it nothing
  # fails: the result is simply a browser with no Floorp features in it.
  if ! grep -q '"noraneko"' moz.build; then
    echo '==> ERROR: "noraneko" is not in moz.build DIRS; the packaging patches did not land' >&2
    exit 1
  fi

  # set floorp version
  local _floorp_ver=$(cat "noraneko/static/gecko/config/version.txt")
  local _firefoxf_ver=$(sed -E -e 's&^.*@&&' "browser/config/version.txt")
  echo "${_floorp_ver}@${_firefoxf_ver}" | tee "browser/config/"{version,version_display}.txt

  echo "Building browser..."
  ./mach build --priority normal

  # Proof that the dropped check did not get built in after all. An object kept from
  # an earlier build() brings it back with nothing failing, and the string comes from
  # nowhere else in libxul (12/10/2026).
  local _xul=obj-artifact-build-output/dist/bin/libxul.so
  if [[ ! -s "$_xul" ]] || grep -aq 'buildid2' "$_xul"; then
    echo "==> ERROR: $_xul is missing or still has the buildid2 check; see _floorp_dropped_patch" >&2
    exit 1
  fi

  # missing on install
  cp noraneko/_dist/buildid2 obj-artifact-build-output/dist/bin/browser

  # dereference symlinks
  rsync -aL obj-artifact-build-output/ obj-artifact-build-output_new/
  rm -rf obj-artifact-build-output_old
  mv obj-artifact-build-output obj-artifact-build-output_old
  mv obj-artifact-build-output_new obj-artifact-build-output

  # floorp post-mach
  _deno task feles-build build --phase after-mach

  # floorp patches 3/3
  for i in noraneko/tools/patches/*.patch; do
    # Platform-specific patches (custom app icons) are Windows/macOS-only; Floorp's
    # own package.yml skips them on Linux the same way.
    case "$i" in
      *.windows.patch | *.darwin.patch) continue ;;
    esac
    # Reverse check FIRST here, as Floorp's package.yml does for this step. Two of
    # these (workspace-last-tab, chrome-extras-sidebar-header) are pure insertions
    # that still pass a forward check once applied, and the built output survives a
    # second makepkg run: applied twice, Tabbrowser.sys.mjs declares a const twice
    # and no longer parses, with nothing failing in the build. (Not in the helper:
    # upstream/ has two patches with the same hunk that are both meant to land.)
    if git apply --check --reverse --directory obj-artifact-build-output/dist/bin --unsafe-paths "$i" 2> /dev/null; then
      echo "Already applied: $i"
      continue
    fi
    _floorp_patch "$i" --directory obj-artifact-build-output/dist/bin --unsafe-paths || exit 1
  done

  # preference override
  bash noraneko/static/gecko/pref/override.sh obj-artifact-build-output/dist/bin/browser/defaults/preferences/firefox.js
)

package() {
  cd "$_pkgsrc_runtime"
  DESTDIR="$pkgdir" ./mach install

  local vendorjs="$pkgdir/$_install_path/$_pkgname/browser/defaults/preferences/vendor.js"
  install -Dm644 /dev/stdin "$vendorjs" << END
// Use LANG environment variable to choose locale
pref("intl.locale.requested", "");

// Use system-provided dictionaries
pref("spellchecker.dictionary_path", "/usr/share/hunspell");

// Disable default browser checking.
pref("browser.shell.checkDefaultBrowser", false);

// Don't disable extensions in the application directory
pref("extensions.autoDisableScopes", 11);

// Enable GNOME Shell search provider
pref("browser.gnome-search-provider.enabled", true);

// Enable JPEG XL images
pref("image.jxl.enabled", true);

// Prevent about:config warning
pref("browser.aboutConfig.showWarning", false);

// Prevent telemetry notification
pref("services.settings.main.search-telemetry-v2.last_check", $(date +%s));
END

  local distini="$pkgdir/$_install_path/$_pkgname/distribution/distribution.ini"
  install -Dm644 /dev/stdin "$distini" << END
[Global]
id=archlinux
version=rolling
about=Floorp for Arch Linux

[Preferences]
app.distributor=archlinux
app.distributor.channel=$_pkgname
app.partner.archlinux=archlinux
END

  # search provider
  local sprovider="$pkgdir/usr/share/gnome-shell/search-providers/$_pkgname.search-provider.ini"
  install -Dm644 /dev/stdin "$sprovider" << END
[Shell Search Provider]
DesktopId=$_pkgname.desktop
BusName=org.mozilla.${_pkgname//-/}.SearchProvider
ObjectPath=/org/mozilla/${_pkgname//-/}/SearchProvider
Version=2
END

  # Replace duplicate binary
  ln -sf "$_pkgname" "$pkgdir/$_install_path/$_pkgname/$_pkgname-bin"

  # launcher
  local _desktop=$(sed -e "s/@WMCLASS@/$_wmclass/" "$srcdir/$_pkgname.desktop")
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$_pkgname.desktop" <<< "$_desktop"

  # icon
  local theme=floorp-official
  install -Dm644 "browser/branding/$theme/default256.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/$_pkgname.png"

  for i in 16 32 48 64 128; do
    local _icon_dest="$pkgdir/usr/share/icons/hicolor/${i}x${i}/apps"
    mkdir -pm755 "$_icon_dest"
    ln -sf "/$_install_path/floorp/browser/chrome/icons/default/default${i}.png" "$_icon_dest/$_pkgname.png"
  done
}
